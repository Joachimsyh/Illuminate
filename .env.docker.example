# Copy to .env.docker before `docker compose up --build`
#   cp .env.docker.example .env.docker

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-string-in-production

# LinkedIn OAuth (optional — demo login works without these)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

DEMO_MODE=true
LUMA_DEMO_SUBMIT=true

# --- Monad premium top-ups (x402 / USDC) ---
# testnet | mainnet (default: testnet)
MONAD_CHAIN=testnet
# App wallet that receives USDC top-up payments (required)
MONAD_PAY_TO=
# Only required when MONAD_CHAIN=mainnet (canonical USDC on Monad)
# MONAD_USDC_MAINNET=
# Override facilitator (defaults to Monad's hosted facilitator)
# MONAD_FACILITATOR_URL=https://x402-facilitator.molandak.org

# Set by docker-compose; override only if needed
# DATABASE_URL=postgresql://luma:luma@db:5432/luma_autoapply

# Agent interval (ms) when using --profile agent
AGENT_INTERVAL_MS=3600000

# LLM — Agent 1 (NVIDIA primary, OpenRouter fallback)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=z-ai/glm-5.2
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Set to 1 if Docker builds fail with certificate / SSL errors
SSL_NO_VERIFY=0
