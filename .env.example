# --- Local npm run dev (Postgres via Docker) ---
# Start DB only:  docker compose up -d db
DATABASE_URL="postgresql://luma:luma@localhost:5432/luma_autoapply?schema=public"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-string"

# LinkedIn Developer App — https://www.linkedin.com/developers/apps
# Redirect URI: http://localhost:3000/api/auth/callback/linkedin
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
# LinkedIn redirect URI must include:
#   http://localhost:3000/api/auth/callback/linkedin

DEMO_MODE="true"
LUMA_DEMO_SUBMIT="true"

# Resend — https://resend.com (also put in .env.local for local testing)
RESEND_API_KEY=""


# Optional: revert to SQLite using prisma/schema.sqlite.prisma
# DATABASE_URL="file:./dev.db"
