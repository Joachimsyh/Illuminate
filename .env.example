# --- Local npm run dev (Postgres via Docker) ---
# Start DB:  npm run db:up
# Apply schema: npm run db:schema
DATABASE_URL="postgresql://luma:luma@127.0.0.1:5434/luma_autoapply"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-string"

# LinkedIn Developer App — https://www.linkedin.com/developers/apps
# Redirect URI: http://localhost:3000/api/auth/callback/linkedin
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

LUMA_DEMO_SUBMIT="true"

# --- Monad premium top-ups (x402 / USDC) ---
# testnet | mainnet (default: testnet)
MONAD_CHAIN="testnet"
# App wallet that receives USDC top-up payments (required)
MONAD_PAY_TO=""
# Only required when MONAD_CHAIN=mainnet (canonical USDC on Monad)
# MONAD_USDC_MAINNET=""
# Override facilitator (defaults to Monad's hosted facilitator)
# MONAD_FACILITATOR_URL="https://x402-facilitator.molandak.org"

# Resend — https://resend.com
RESEND_API_KEY=""

# Scrape proxy key — only used for user-requested event pages (not bulk discover)
SCRAPE_API_KEY=""

# LLM — Agent 1 (NVIDIA primary, OpenRouter fallback)
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL="z-ai/glm-5.2"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"

# Set to 1 if HTTPS fails with certificate errors (common on Windows)
SSL_NO_VERIFY=""
