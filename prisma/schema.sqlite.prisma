generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(cuid())
  name                String?
  email               String?   @unique
  emailVerified       DateTime?
  image               String?
  passwordHash        String?
  linkedinId          String?   @unique
  /// Name used on Luma guest lists
  registrationName    String?
  /// Email used for Luma registrations
  registrationEmail   String?
  headline            String?
  company             String?
  location            String?
  bio                 String?
  skills              String    @default("")
  techStack           String    @default("")
  interests           String    @default("")
  seniority           String?
  eventTypes          String    @default("")
  /// Pasted CV / LinkedIn profile text (Agent 1 input)
  rawSource           String    @default("")
  /// JSON array of pasted LinkedIn posts (voice reference)
  writingSamples      String    @default("[]")
  onboardingCompleted Boolean   @default(false)
  onboardingStep      Int       @default(1)
  agentEnabled        Boolean   @default(false)
  agentKeywords       String    @default("ai,hackathon,startup,web3")
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  loginSessions  LoginSession[]
  applications   Application[]
  oauthTokens    OAuthToken?
  lumaConnection LumaConnection?
}

model LumaConnection {
  id              String    @id @default(cuid())
  userId          String    @unique
  /// AES-encrypted ICS URL (credential)
  icsUrlEncrypted String
  icsUrlLastOkAt  DateTime?
  status          String    @default("active")
  previewJson     String    @default("[]")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginSession {
  id        String   @id @default(cuid())
  userId    String
  provider  String
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())
  expiresAt DateTime?
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model OAuthToken {
  id           String    @id @default(cuid())
  userId       String    @unique
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  provider     String    @default("linkedin")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Application {
  id           String    @id @default(cuid())
  userId       String
  eventId      String
  eventTitle   String
  eventUrl     String
  eventDate    String?
  status       String    @default("pending")
  message      String?
  formPayload  String?
  responseBody String?
  appliedAt    DateTime  @default(now())
  notifiedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([status])
}
